rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;
    }

    match /artifacts/{appId}/users/{uid}/{document=**} {
      allow read, write: if owns(uid);
    }

    // Backward compatibility for the existing anonymous demo path. Do not put
    // personal data here; authenticated users must use their private UID path.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
